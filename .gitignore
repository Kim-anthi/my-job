# SQLite WebAssembly binary, needed only for web builds. Fetched, not committed:
#   curl -L -o web/sqlite3.wasm https://github.com/simolus3/sqlite3.dart/releases/download/sqlite3-3.1.2/sqlite3.wasm
/web/sqlite3.wasm
/web/sqflite_sw.js
